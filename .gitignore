# ── Secrets: NEVER commit ──────────────────────────────
# app/.env holds the tenant private key (T3N_API_KEY) and the Resend key.
.env
app/.env
**/.env
# (…but the template is safe and SHOULD be committed)
!app/.env.example
!**/.env.example

# ── Dependencies ───────────────────────────────────────
node_modules/

# ── Rust build output ──────────────────────────────────
target/

